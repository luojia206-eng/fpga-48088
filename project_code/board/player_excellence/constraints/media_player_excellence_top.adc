set_pin_assignment { sys_clk }    { LOCATION = R7;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { sys_rst_n }  { LOCATION = A2;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key2_n }     { LOCATION = B2;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key3_n }     { LOCATION = B1;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key4_n }     { LOCATION = C1;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
# UART TX drives BOTH paths while the bring-up cabling is being sorted out:
#   D12 = on-board CH340 (Type-C), proven to enumerate as COM7/8/11/12
#   P4  = J2 expansion header pin 1, for an external USB-TTL module
# The CH340 socket and the HDMI B connector are too close to use together, so
# the J2 fan-out below is kept as the parallel fallback.
set_pin_assignment { uart_tx_o }  { LOCATION = D12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
# UART RX: F12 is the CH340 transmit line into the FPGA (HX4S20 manual, section
# 7 "USB to UART": RXD = F12, TXD = D12). This makes the on-board Type-C link
# full duplex, so the PC can rewrite the on-screen text at run time.
set_pin_assignment { uart_rx_i }  { LOCATION = F12; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
# Second receive input for an external USB-TTL module. N4 is J2 expansion
# header pin 2 (right next to pin 1 / P4). The two RX lines are ANDed inside
# the top level, so either source can drive the on-screen text.
set_pin_assignment { uart_rx_ext_i } { LOCATION = N4; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
# TEMPORARY debug: same UART TX bit on all 36 IO of the J2 expansion header,
# so the USB-TTL RX lead can be clamped on ANY signal pin (no pin-1 hunting).
# Pins 11/12/29/30 are VCC5V/GND/3V3/GND and cannot be assigned.
set_pin_assignment { dbg_tx[0]  } { LOCATION = P4;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[1]  } { LOCATION = D14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[2]  } { LOCATION = N3;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[3]  } { LOCATION = M5;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[4]  } { LOCATION = M3;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[5]  } { LOCATION = M4;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[6]  } { LOCATION = L3;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[7]  } { LOCATION = J3;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[8]  } { LOCATION = J4;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[9]  } { LOCATION = H4;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[10] } { LOCATION = N1;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[11] } { LOCATION = M2;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[12] } { LOCATION = M1;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[13] } { LOCATION = L1;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[14] } { LOCATION = H2;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[15] } { LOCATION = H1;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[16] } { LOCATION = G1;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[17] } { LOCATION = G3;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[18] } { LOCATION = L4;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[19] } { LOCATION = L5;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[20] } { LOCATION = K6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[21] } { LOCATION = H3;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[22] } { LOCATION = H5;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[23] } { LOCATION = F3;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[24] } { LOCATION = E2;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[25] } { LOCATION = J11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[26] } { LOCATION = J12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[27] } { LOCATION = K11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[28] } { LOCATION = K14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[29] } { LOCATION = L12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[30] } { LOCATION = M12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[31] } { LOCATION = M11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[32] } { LOCATION = N12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[33] } { LOCATION = P14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[34] } { LOCATION = P12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { dbg_tx[35] } { LOCATION = R12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { sd_cs_n }    { LOCATION = A12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment { sd_mosi }    { LOCATION = A13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { sd_sclk }    { LOCATION = A14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { sd_miso }    { LOCATION = B14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { flash_cs_n }   { LOCATION = P8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { flash_miso }   { LOCATION = N8; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { flash_sclk }   { LOCATION = M9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { flash_wp_n }   { LOCATION = P9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { flash_hold_n } { LOCATION = R9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { flash_mosi }   { LOCATION = P7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
# HDMI B port (HX4S20 manual 2-11). N side auto-pairs:
# CLK_N=C2, D0_N=G6, D1_N=F2, D2_N=D1.
# The A port (K1/F5/E3/B3) was retested on 2026-10-24 and still produced no
# TMDS output, so this board's A connector is treated as unusable. Do not move
# the lanes back without the manual's 2-11 table and a scope.
set_pin_assignment { HDMI_CLK_P } { LOCATION = C3;  IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment { HDMI_D0_P }  { LOCATION = G5;  IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment { HDMI_D1_P }  { LOCATION = F1;  IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment { HDMI_D2_P }  { LOCATION = E1;  IOSTANDARD = LVDS33; PULLTYPE = NONE; }
# HDMI B-port DDC (the vendor transmitter core reads EDID over I2C).
set_pin_assignment { HDMI_DDC_SCL } { LOCATION = P2; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment { HDMI_DDC_SDA } { LOCATION = R2; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment { led[0] }     { LOCATION = A4;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { led[1] }     { LOCATION = A3;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { led[2] }     { LOCATION = C10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { led[3] }     { LOCATION = B12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
